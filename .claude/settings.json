{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose exec -e RAILS_ENV=test web bundle exec rspec*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(rg *)",
      "Bash(docker compose exec -T web bundle exec rubocop*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./config/master.key)",
      "Read(./config/credentials/.key)"
    ],
    "ask": [
      "Bash(docker compose * rails db:drop*)",
      "Bash(docker compose * rails db:reset*)",
      "Bash(docker compose * rails db:schema:load*)",
      "Bash(docker compose * rails db:structure:load*)",
      "Bash(docker compose * rails db:migrate*)",
      "Bash(bundle exec rails db:drop)",
      "Bash(bundle exec rails db:reset*)",
      "Bash(bundle exec rails db:schema:load*)",
      "Bash(bundle exec rails db:structure:load*)",
      "Bash(bundle exec rails db:migrate*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rubocop.sh"
          }
        ]
      }
    ]
  }
}
