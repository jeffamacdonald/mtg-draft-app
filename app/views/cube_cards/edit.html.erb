<%= turbo_frame_tag "modal" do %>
  <div class="modal d-block" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= render(ButtonComponent.new(classes: "btn-x ms-auto", variation: :secondary, data: { controller: "modal", action: "modal#close"})) { "X" } %>
        <div class="text-center"><%= @cube_card.card.name %></div>
        <%= form_with(model: @cube_card, local: true) do |f| %>
          <div class="pt-3 row justify-content-center">
            <div class="col-11 col-md-6 text-start d-grid gap-2">
              <div>
                <%= f.label :custom_color_identity, "Color Identity", class: "fw-bold" %>
                <%= f.collection_check_boxes :custom_color_identity, Card::ColorIdentity::COLOR_IDENTITIES.invert.to_a, :last, :first do |b| %>
                  <div class="form-check">
                    <%= b.check_box(class: "form-check-input") %>
                    <%= b.label(class: "form-check-label") %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="row justify-content-center">
            <%= render(ButtonComponent.new(variation: :primary, classes: "col-auto mt-2", data: { turbo: false })) { "Update" } %>
          </div>
        <% end %>
        <%= form_with(url: cube_card_path(@cube_card), method: :delete) do |f| %>
          <div class="row justify-content-center">
            <%= render(ButtonComponent.new(variation: :danger, classes: "col-auto mt-2 mb-2", data: { turbo: false })) { "Delete" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
