<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      /* Most layout is inline (email clients); this only styles links where <style> is supported. */
      a { color: #7a1f1f; }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #1a1410;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #1a1410;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width: 100%; max-width: 560px; background-color: #e4d3a6; border: 3px double #c9a227;">
            <tr>
              <td align="center" style="background-color: #0e0a07; padding: 16px; border-bottom: 3px double #c9a227; font-family: Georgia, 'Times New Roman', serif; font-size: 26px; letter-spacing: 1px; color: #d8b46a;">
                Never Noid
              </td>
            </tr>
            <tr>
              <td style="padding: 20px; font-family: Georgia, 'Times New Roman', serif; font-size: 16px; line-height: 1.5; color: #2b1d10; white-space: pre-line;"><%= yield %></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
