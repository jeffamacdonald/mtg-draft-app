<% if picked? || participant_pick.skipped? %>
  <td id="participant_pick_<%= participant_pick.id %>" 
    class="<%= pick_classes %>"
    data-controller="<%= hovercard_controller %>"
    data-hovercard-url-value="<%= hovercard_url %>"
    data-action="<%= hovercard_actions %>">
    <%= card_name || "SKIPPED" %>
  </td>
<% else %>
  <td
    id="participant_pick_<%= participant_pick.id %>"
    class="<%= pick_classes %> position-relative"
    data-controller="<%= hovercard_controller %>"
    data-hovercard-url-value="<%= hovercard_url %>"
    data-action="<%= hovercard_actions %>"
  >
    <turbo-frame id="participant_pick_<%= participant_pick.id %>_comment">
      <a class="stretched-link" href="<%= edit_path %>"><span class="visually-hidden">Edit comment</span></a>
      <%= comment_html %>
    </turbo-frame>
  </td>
<% end %>
