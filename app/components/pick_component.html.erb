<% if participant_pick.cube_card.present? || participant_pick.skipped? %>
  <td id="participant_pick_<%= participant_pick.id %>" 
    class="<%= pick_classes %>"
    data-controller="<%= hovercard_controller %>"
    data-hovercard-url-value="<%= hovercard_url %>"
    data-action="<%= hovercard_actions %>">
    <%= participant_pick.name || "SKIPPED" %>
  </td>
<% else %>
  <td
    id="participant_pick_<%= participant_pick.id %>"
    class="<%= pick_classes %> position-relative"
    data-controller="<%= hovercard_controller %>"
    data-hovercard-url-value="<%= hovercard_url %>"
    data-action="<%= hovercard_actions %>"
  >
    <turbo-frame id="participant_pick_<%= participant_pick.id %>_comment">
      <a class="stretched-link" href="<%= edit_participant_pick_path(participant_pick) %>"><span class="visually-hidden">Edit comment</span></a>
      <%= helpers.auto_link(participant_pick.comment, html: { target: "_blank", class: "position-relative", style: "z-index: 2;" }) %>
    </turbo-frame>
  </td>
<% end %>
