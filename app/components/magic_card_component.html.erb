<a id="magic_card_<%= cube_card.id %>"<% if size_class %> class="<%= size_class %>"<% end %> data-turbo-frame="modal" href="<%= link_url %>">
  <div class="d-flex">
    <% if context.text_only? %>
      <div class="text-start <%= text_only_class %>">
        <%= cube_card.name %>
      </div>
    <% else %>
      <img class="flex-fill <%= css_class %>" src="<%= cube_card.image_url %>" />
    <% end %>
  </div>
</a>