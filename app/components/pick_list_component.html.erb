<div id="draft_<%= draft.id %>_pick_list" class="min-w-0" data-turbo-frame>
  <%= render(DisplayCardComponent.new(width: :xxl, classes: "mb-2 min-w-0")) do %>
    <div class="card-header">
      <div class="d-flex flex-row">
        <div class="col-md-4 col-12 d-flex flex-row">
          <div class="fw-bold">Text Size: </div>
          <%= form_with url: pick_list_size_draft_path(draft), class: "px-1", data: { controller: "auto-submit" } do |f| %>
            <%= f.select :text_size, [["Small", "small-text"], ["Medium", "med-text"], ["Large", "lg-text"]], { selected: font_size },
                  { class: "font-display", autocomplete: "off", data: { controller: "pixel-select", action: "change->auto-submit#submit" } } %>
          <% end %>
        </div>
        <div class="col-md-4 d-md-inline d-none">
          PICKS
        </div>
        <div class="col-md-4 d-md-inline d-none">
        </div>
      </div>
    </div>
    <div class="table-responsive fs-6">
      <table class="small-table table table-bordered font-display <%= font_size %>">
        <thead>
          <tr>
            <th scope="col" class="fw-bold">Rd</th>
            <% ordered_participants.each do |participant| %>
              <th scope="col" class="pick-list-header <%= active_participant_class(participant) %>">
                <%= render(ButtonComponent.new(url: picks_draft_participant_path(participant), variation: :link, classes: font_size)) { participant.display_name } %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% grouped_picks_by_round.each do |round, picks| %>
            <tr>
              <td class="fw-bold"><%= round %></td>
              <% sorted_picks = round % 2 == 0 ? picks.reverse : picks %>
              <% sorted_picks.each do |pick| %>
                <%= render(PickComponent.new(pick)) %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
